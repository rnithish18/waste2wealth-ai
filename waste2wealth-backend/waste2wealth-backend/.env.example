# ==============================
# SERVER
# ==============================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==============================
# DATABASE (MongoDB / Supabase alt -> use MongoDB Atlas)
# ==============================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/waste2wealth?retryWrites=true&w=majority

# ==============================
# JWT AUTH
# ==============================
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# ==============================
# GROQ AI (https://console.groq.com)
# ==============================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# ==============================
# GOOGLE OAUTH
# ==============================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================
# EMAIL (Nodemailer - for verification / OTP / reset password)
# ==============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Waste2Wealth AI <no-reply@waste2wealth.ai>

# ==============================
# CLOUDINARY (image storage for waste listings)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=200
